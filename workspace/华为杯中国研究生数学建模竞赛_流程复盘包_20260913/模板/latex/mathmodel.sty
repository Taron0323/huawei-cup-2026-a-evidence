\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\zihao{5}\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\setlength{\headheight}{0pt}
\raggedbottom
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000

\newcommand{\papertitle}[1]{\begin{center}{\songti\bfseries\fontsize{16bp}{22bp}\selectfont#1\par}\end{center}\vspace{5bp}}
\newenvironment{modelabstract}{\begin{center}\heiti\fontsize{14bp}{18bp}\selectfont 摘要\end{center}\fontsize{12bp}{17.15bp}\selectfont\noindent\hspace*{2em}\ignorespaces}{\par}
\newcommand{\keywords}[1]{\par\vspace{8pt}\noindent{\heiti 关键词：}#1\par}
\newcommand{\placeholder}[1]{\textcolor{PlaceholderGray}{【待填写：#1】}}
\newcommand{\sampleonly}{\noindent\textcolor{PlaceholderGray}{\small 排版演示，非赛题结果。}\par}
\newcommand{\R}{\mathbb{R}}
\newcommand{\E}{\mathbb{E}}
