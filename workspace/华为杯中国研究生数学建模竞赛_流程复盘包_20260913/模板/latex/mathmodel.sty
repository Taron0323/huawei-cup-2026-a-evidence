\newcommand{\dif}{\mathop{}\!\mathrm{d}}
\newtheorem{assumption}{假设}
\newtheorem{lemma}{引理}
\newtheorem{proposition}{命题}
\renewcommand{\proofname}{证明}

\lstdefinestyle{modelcode}{
  basicstyle=\ttfamily\footnotesize,keywordstyle=\color{ModelBlue},
  commentstyle=\color{ModelGreen},stringstyle=\color{ModelInk},
  numbers=left,numberstyle=\tiny\color{PlaceholderGray},numbersep=8pt,
  frame=tb,rulecolor=\color{ModelInk},breaklines=true,breakatwhitespace=false,
  columns=fullflexible,keepspaces=true,showstringspaces=false,tabsize=4,
  aboveskip=10pt,belowskip=10pt,captionpos=t
}
\lstset{style=modelcode}
\renewcommand{\lstlistingname}{代码}

\newcommand{\beginappendices}{%
  \label{mainbody:end}\clearpage\appendix
  \ctexset{section={name={附录\space,},number=\Alph{section},aftername=\quad},
    subsection={number=\Alph{section}.\arabic{subsection}.},
    subsubsection={number=\Alph{section}.\arabic{subsection}.\arabic{subsubsection}.}}}

