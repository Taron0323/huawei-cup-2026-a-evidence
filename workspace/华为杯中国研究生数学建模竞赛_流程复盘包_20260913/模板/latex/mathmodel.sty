\ctexset{
  section={format=\centering\heiti\fontsize{14bp}{18bp}\selectfont,
    name={,.},number=\arabic{section},aftername=\quad,
    beforeskip=16bp,afterskip=12bp},
  subsection={format=\kaishu\fontsize{14bp}{18bp}\selectfont,
    number=\arabic{section}.\arabic{subsection}.,aftername=\quad,
    beforeskip=10bp,afterskip=5bp},
  subsubsection={format=\songti\bfseries\fontsize{12bp}{15.6bp}\selectfont,
    number=\arabic{section}.\arabic{subsection}.\arabic{subsubsection}.,aftername=\quad,
    beforeskip=8bp,afterskip=4bp}
}
\setcounter{secnumdepth}{3}
\setlength{\parindent}{2em}
\setlength{\parskip}{0pt}
\linespread{1}
\renewcommand{\normalsize}{\fontsize{12bp}{15.6bp}\selectfont}
\AtBeginDocument{\normalsize}
\setlength{\abovedisplayskip}{8pt plus 2pt minus 2pt}
\setlength{\belowdisplayskip}{8pt plus 2pt minus 2pt}
\setlength{\textfloatsep}{12pt plus 2pt minus 2pt}
\setlength{\intextsep}{12pt plus 2pt minus 2pt}
\setlength{\emergencystretch}{1.5em}
\renewcommand{\arraystretch}{1.22}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\DeclareCaptionFont{maomao}{\kaishu\fontsize{12bp}{15.6bp}\selectfont}
\captionsetup{font=maomao,labelsep=quad,skip=6pt}
\captionsetup[table]{position=top}
\captionsetup[figure]{position=bottom}
